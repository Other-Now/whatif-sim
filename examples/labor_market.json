{
  "name": "labor_market",
  "question": "What happens to US unemployment over the next 24 months if the rate at which unemployed people find jobs falls 20% from month 3?",
  "time_unit": "month",
  "horizon": 24.0,
  "dt_out": 1.0,
  "stocks": [
    {
      "name": "employed",
      "unit": "kpeople",
      "initial": "employed0",
      "nonnegative": true,
      "description": "Employed persons, thousands"
    },
    {
      "name": "unemployed",
      "unit": "kpeople",
      "initial": "unemployed0",
      "nonnegative": true,
      "description": "Unemployed persons, thousands"
    }
  ],
  "flows": [
    {
      "name": "hires",
      "from": "unemployed",
      "to": "employed",
      "rate": "find_rate * demand * unemployed",
      "description": "Unemployed people finding a job each month"
    },
    {
      "name": "separations",
      "from": "employed",
      "to": "unemployed",
      "rate": "sep_rate * employed",
      "description": "Employed people losing or leaving a job into unemployment each month"
    }
  ],
  "aux": [
    {
      "name": "unemployment_rate",
      "expr": "unemployed / (employed + unemployed)",
      "unit": "1",
      "description": ""
    },
    {
      "name": "demand",
      "expr": "max(demand_floor, 1 - demand_sensitivity * (unemployment_rate - u_ref))",
      "unit": "1",
      "description": "Hiring multiplier: higher unemployment means less spending and so fewer job openings"
    }
  ],
  "params": [
    {
      "name": "find_rate",
      "unit": "1/month",
      "dist": {
        "kind": "lognormal",
        "median": 0.25833,
        "gsd": 1.065374
      },
      "source": {
        "kind": "fred",
        "series": [
          "LNS17100000",
          "LNS13000000"
        ],
        "transform": "flow_over_lagged_level: monthly flow_t / level_(t-1) over the window, lognormal fitted (unit: 1/month)",
        "window": "2023-08-01..2026-09-01 (36 months)",
        "fetched_at": "2026-10-18T12:34:20+00:00",
        "note": "via BLS (CPS)"
      },
      "description": "Share of the unemployed who find a job each month"
    },
    {
      "name": "sep_rate",
      "unit": "1/month",
      "dist": {
        "kind": "lognormal",
        "median": 0.009677,
        "gsd": 1.083519
      },
      "source": {
        "kind": "fred",
        "series": [
          "LNS17400000",
          "LNS12000000"
        ],
        "transform": "flow_over_lagged_level: monthly flow_t / level_(t-1) over the window, lognormal fitted (unit: 1/month)",
        "window": "2023-08-01..2026-09-01 (36 months)",
        "fetched_at": "2026-10-18T12:34:19+00:00",
        "note": "via BLS (CPS)"
      },
      "description": "Share of the employed who become unemployed each month"
    },
    {
      "name": "employed0",
      "unit": "kpeople",
      "dist": {
        "kind": "fixed",
        "value": 163152.0
      },
      "source": {
        "kind": "fred",
        "series": [
          "LNS12000000"
        ],
        "transform": "latest: latest observation of the series, as a fixed value",
        "window": "2026-09-01",
        "fetched_at": "2026-10-18T12:34:19+00:00",
        "note": "via BLS (CPS)"
      },
      "description": ""
    },
    {
      "name": "unemployed0",
      "unit": "kpeople",
      "dist": {
        "kind": "fixed",
        "value": 7109.0
      },
      "source": {
        "kind": "fred",
        "series": [
          "LNS13000000"
        ],
        "transform": "latest: latest observation of the series, as a fixed value",
        "window": "2026-09-01",
        "fetched_at": "2026-10-18T12:34:20+00:00",
        "note": "via BLS (CPS)"
      },
      "description": ""
    },
    {
      "name": "u_ref",
      "unit": "1",
      "dist": {
        "kind": "fixed",
        "value": 0.041754
      },
      "source": {
        "kind": "fred",
        "series": [
          "LNS13000000",
          "LNS12000000"
        ],
        "transform": "share_latest: latest a / (a + b), as a fixed value",
        "window": "2026-09-01",
        "fetched_at": "2026-10-18T12:34:19+00:00",
        "note": "via BLS (CPS)"
      },
      "description": ""
    },
    {
      "name": "demand_sensitivity",
      "unit": "1",
      "dist": {
        "kind": "uniform",
        "low": 0.0,
        "high": 5.0
      },
      "source": {
        "kind": "assumption",
        "series": [],
        "transform": "",
        "window": "",
        "fetched_at": "",
        "note": "No direct data. Range means a 1 point rise in unemployment cuts job finding by 0-5%. Sobol shows how much the answer depends on it."
      },
      "description": ""
    },
    {
      "name": "demand_floor",
      "unit": "1",
      "dist": {
        "kind": "fixed",
        "value": 0.2
      },
      "source": {
        "kind": "assumption",
        "series": [],
        "transform": "",
        "window": "",
        "fetched_at": "",
        "note": "Guard so hiring never goes to zero; not reached in any scenario here."
      },
      "description": ""
    }
  ],
  "outputs": [
    "unemployment_rate",
    "unemployed",
    "employed"
  ],
  "scenarios": [
    {
      "name": "find_rate_down_20",
      "description": "Job-finding rate falls 20% from month 3 onward",
      "changes": [
        {
          "param": "find_rate",
          "multiply": 0.8,
          "from_t": 3.0
        }
      ]
    }
  ]
}
